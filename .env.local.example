# Copy this file to .env.local and fill in your credentials.
# Never commit .env.local to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these at: https://app.supabase.com → Project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret — backend only

# ── Anthropic (optional — only needed for LLM qualitative review) ─────────────
# Find this at: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Local dev only (not needed on Vercel) ────────────────────────────────────
# Tells Next.js to proxy /api/* to the local Python server.
# Remove or leave unset when deploying to Vercel.
PYTHON_API_URL=http://localhost:8000
